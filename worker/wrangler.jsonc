{
  "name": "emnifun",
  "main": "index.js",
  "compatibility_date": "2026-10-04",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emnifun-db",
      "database_id": "10ae7385-bdc8-45c9-9739-d4815fc3f6ec",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "474720562463-f64vlq15je8q5or8ud1gbr4fvkio8o29.apps.googleusercontent.com",
    "AUTH_ALLOWED_ORIGIN": "https://emnifun.github.io",
    "AUTH_SESSION_TTL_SECONDS": "2592000",
    "AUTH_CHALLENGE_TTL_SECONDS": "600",
    "GOOGLE_CHANGE_COOLDOWN_SECONDS": "2592000",
    "AUTH_COOKIE_SAMESITE": "None",
    "AUTH_COOKIE_PARTITIONED": "true",
    "RECOVERY_VAULT_SECRET_VERSION": "1",
    "RECOVERY_KEY_VISIBILITY_SECONDS": "172800"
  },
  "triggers": {
    "crons": [
      "15 * * * *"
    ]
  }
}
